import React, { useState } from "react";

function TextAnalyzer() {
  const [text, setText] = useState("");
  const [corrections, setCorrections] = useState([]);
  const [loading, setLoading] = useState(false);

  const analyzeText = async () => {
    if (!text.trim()) {
      alert("Digite algum texto.");
      return;
    }

    setLoading(true);

    try {
      const response = await fetch(
        "https://api.languagetool.org/v2/check",
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/x-www-form-urlencoded",
          },
          body: new URLSearchParams({
            text,
            language: "pt-BR",
          }),
        }
      );

      if (!response.ok) {
        throw new Error("Erro ao acessar a API.");
      }

      const data = await response.json();

      setCorrections(
        data.matches.sort(
          (a, b) => a.offset - b.offset
        )
      );
    } catch (error) {
      console.error(error);
      alert("Erro ao analisar o texto.");
    } finally {
      setLoading(false);
    }
  };

  const applyCorrection = async (index) => {
    const correction = corrections[index];

    if (
      !correction ||
      correction.replacements.length === 0
    ) {
      return;
    }

    const replacement =
      correction.replacements[0].value;

    const start = correction.offset;
    const end = correction.offset + correction.length;

    const newText =
      text.substring(0, start) +
      replacement +
      text.substring(end);

    setText(newText);

    try {
      const response = await fetch(
        "https://api.languagetool.org/v2/check",
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/x-www-form-urlencoded",
          },
          body: new URLSearchParams({
            text: newText,
            language: "pt-BR",
          }),
        }
      );

      const data = await response.json();

      setCorrections(
        data.matches.sort(
          (a, b) => a.offset - b.offset
        )
      );
    } catch (error) {
      console.error(error);
    }
  };

  const applyAllCorrections = async () => {
    let correctedText = text;

    const sorted = [...corrections].sort(
      (a, b) => b.offset - a.offset
    );

    sorted.forEach((correction) => {
      if (correction.replacements.length > 0) {
        const replacement =
          correction.replacements[0].value;

        correctedText =
          correctedText.substring(
            0,
            correction.offset
          ) +
          replacement +
          correctedText.substring(
            correction.offset +
              correction.length
          );
      }
    });

    setText(correctedText);
    setCorrections([]);
  };

  const clearAll = () => {
    setText("");
    setCorrections([]);
  };

  const renderHighlightedText = () => {
    if (!corrections.length) {
      return text;
    }

    const elements = [];
    let lastIndex = 0;

    corrections.forEach((correction, index) => {
      const start = correction.offset;
      const end = correction.offset + correction.length;

      elements.push(
        <span key={`text-${index}`}>
          {text.substring(lastIndex, start)}
        </span>
      );

      elements.push(
        <span
          key={`error-${index}`}
          onClick={() =>
            applyCorrection(index)
          }
          title={`${correction.message} | Sugestão: ${
            correction.replacements[0]?.value ||
            ""
          }`}
          style={{
            backgroundColor: "#ffb3b3",
            color: "#900",
            cursor: "pointer",
            borderRadius: "4px",
            padding: "2px 4px",
            fontWeight: "bold",
          }}
        >
          {text.substring(start, end)}
        </span>
      );

      lastIndex = end;
    });

    elements.push(
      <span key="final">
        {text.substring(lastIndex)}
      </span>
    );

    return elements;
  };

  const wordCount = text
    .trim()
    .split(/\s+/)
    .filter(Boolean).length;

  const charCount = text.length;

  return (
    <div
      style={{
        maxWidth: "1000px",
        margin: "20px auto",
        padding: "20px",
        fontFamily: "Arial, sans-serif",
      }}
    >
      <h1>📝 Corretor Inteligente de Texto PRO</h1>

      <textarea
        value={text}
        onChange={(e) =>
          setText(e.target.value)
        }
        placeholder="Digite ou cole seu texto aqui..."
        rows={10}
        style={{
          width: "100%",
          padding: "12px",
          fontSize: "16px",
          borderRadius: "8px",
          border: "1px solid #ccc",
          resize: "vertical",
        }}
      />

      <div
        style={{
          display: "flex",
          gap: "10px",
          marginTop: "15px",
          flexWrap: "wrap",
        }}
      >
        <button
          onClick={analyzeText}
          disabled={loading}
          style={{
            padding: "10px 20px",
            cursor: "pointer",
          }}
        >
          {loading
            ? "Analisando..."
            : "🔍 Analisar Texto"}
        </button>

        <button
          onClick={applyAllCorrections}
          disabled={!corrections.length}
          style={{
            padding: "10px 20px",
            cursor: "pointer",
          }}
        >
          ✅ Corrigir Tudo
        </button>

        <button
          onClick={clearAll}
          style={{
            padding: "10px 20px",
            cursor: "pointer",
          }}
        >
          🗑️ Limpar
        </button>
      </div>

      <div
        style={{
          marginTop: "15px",
          padding: "10px",
          background: "#f5f5f5",
          borderRadius: "8px",
        }}
      >
        <strong>Palavras:</strong> {wordCount}
        {" | "}
        <strong>Caracteres:</strong> {charCount}
        {" | "}
        <strong>Erros:</strong>{" "}
        {corrections.length}
      </div>

      <h2>Texto Analisado</h2>

      <div
        style={{
          border: "1px solid #ddd",
          padding: "15px",
          minHeight: "150px",
          whiteSpace: "pre-wrap",
          lineHeight: "1.8",
          borderRadius: "8px",
          backgroundColor: "#fafafa",
        }}
      >
        {renderHighlightedText()}
      </div>

      <h2>Correções Encontradas</h2>

      {corrections.length === 0 ? (
        <p>Nenhum erro encontrado.</p>
      ) : (
        <ul>
          {corrections.map(
            (correction, index) => (
              <li
                key={index}
                style={{
                  marginBottom: "15px",
                }}
              >
                <strong>
                  {correction.message}
                </strong>

                <br />

                Palavra:
                <em>
                  {" "}
                  {text.substring(
                    correction.offset,
                    correction.offset +
                      correction.length
                  )}
                </em>

                <br />

                Sugestões:
                {" "}
                {correction.replacements
                  .slice(0, 5)
                  .map((r) => r.value)
                  .join(", ")}

                <br />

                <button
                  onClick={() =>
                    applyCorrection(index)
                  }
                  style={{
                    marginTop: "5px",
                    padding:
                      "5px 10px",
                    cursor: "pointer",
                  }}
                >
                  Aplicar Primeira Sugestão
                </button>
              </li>
            )
          )}
        </ul>
      )}
    </div>
  );
}

export default TextAnalyzer;