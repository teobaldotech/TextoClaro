import React, { useState } from "react";

function TextAnalyzer() {
  const [text, setText] = useState("");
  const [corrections, setCorrections] = useState([]);

  const analyzeText = async () => {
    const response = await fetch("https://api.languagetool.org/v2/check", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({
        text: text,
        language: "pt-BR"
      })
    });
    const data = await response.json();
    setCorrections(data.matches);
  };

  // Função para aplicar correção escolhida
  const applyCorrection = (index) => {
    const c = corrections[index];
    if (!c || c.replacements.length === 0) return;

    let chosen = null;

    // Pergunta ao usuário qual sugestão aplicar
    for (let r of c.replacements) {
      if (window.confirm(`Deseja substituir por: "${r.value}" ?`)) {
        chosen = r.value;
        break;
      }
    }

    if (!chosen) return;

    const start = c.offset;
    const end = c.offset + c.length;

    // Substitui no texto original
    const newText = text.substring(0, start) + chosen + text.substring(end);
    setText(newText);

    // Remove a correção aplicada da lista
    const newCorrections = corrections.filter((_, i) => i !== index);
    setCorrections(newCorrections);
  };

  // Função para destacar erros no texto
  const highlightText = () => {
    if (corrections.length === 0) return text;

    let result = "";
    let lastIndex = 0;

    const sortedCorrections = [...corrections].sort((a, b) => a.offset - b.offset);

    sortedCorrections.forEach((c, i) => {
      const start = c.offset;
      const end = c.offset + c.length;
      const wrong = text.substring(start, end);
      const suggestionList = c.replacements.map(r => r.value).join(", ");

      result += text.substring(lastIndex, start);

      result += `<span 
        style="background-color: #ffcccc; cursor: pointer;" 
        title="${c.message} → ${suggestionList}" 
        data-index="${i}"
      >${wrong}</span>`;

      lastIndex = end;
    });

    result += text.substring(lastIndex);
    return result;
  };

  // Captura cliques nos spans
  const handleClick = (e) => {
    if (e.target.dataset.index) {
      applyCorrection(parseInt(e.target.dataset.index));
    }
  };

  return (
    <div style={{ fontFamily: "Arial, sans-serif", padding: "20px" }}>
      <h2>Corretor de Texto Inteligente</h2>
      <textarea
        value={text}
        onChange={(e) => setText(e.target.value)}
        placeholder="Digite seu texto..."
        rows={6}
        cols={60}
        style={{ padding: "10px", fontSize: "16px" }}
      />
      <br />
      <button onClick={analyzeText} style={{ marginTop: "10px" }}>
        Analisar
      </button>

      <h3>Texto analisado:</h3>
      <div
        style={{
          border: "1px solid #ccc",
          padding: "10px",
          marginTop: "10px",
          minHeight: "100px"
        }}
        dangerouslySetInnerHTML={{ __html: highlightText() }}
        onClick={handleClick}
      />

      <h3>Correções sugeridas:</h3>
      <ul>
        {corrections.map((c, i) => (
          <li key={i}>
            <strong>{c.message}</strong>  
            <br />
            Palavra incorreta: <em>{text.substring(c.offset, c.offset + c.length)}</em>  
            <br />
            Sugestões: {c.replacements.map(r => r.value).join(", ")}
          </li>
        ))}
      </ul>
    </div>
  );
}

