<div class="toast" id="toast"></div>

<script>
"use strict";

/* =========================================================
    CONFIGURAÇÃO
========================================================= */

const API_URL = "https://api.languagetool.org/v2/check";

const STORAGE_TEXT = "corretor-pro-ultra-text";
const STORAGE_HISTORY = "corretor-pro-ultra-history";
const STORAGE_THEME = "corretor-pro-ultra-theme";
const STORAGE_LANGUAGE = "corretor-pro-ultra-language";
const STORAGE_FONT = "corretor-pro-ultra-font";

const MAX_TEXT_LENGTH = 60000;
const MAX_HISTORY = 20;
const MAX_UNDO = 30;


/* =========================================================
    ESTADO
========================================================= */

let text = "";
let corrections = [];
let history = [];

let undoStack = [];
let redoStack = [];

let isLoading = false;
let isSpeaking = false;

let analysisController = null;

let selectedCorrection = null;


/* =========================================================
    ELEMENTOS
========================================================= */

const editor = document.getElementById("editor");

const language = document.getElementById("language");
const fontSize = document.getElementById("fontSize");

const status = document.getElementById("status");

const analyzeBtn = document.getElementById("analyzeBtn");
const applyAllBtn = document.getElementById("applyAllBtn");

const copyBtn = document.getElementById("copyBtn");
const downloadBtn = document.getElementById("downloadBtn");
const speakBtn = document.getElementById("speakBtn");

const importBtn = document.getElementById("importBtn");
const fileInput = document.getElementById("fileInput");

const clearBtn = document.getElementById("clearBtn");

const undoBtn = document.getElementById("undoBtn");
const redoBtn = document.getElementById("redoBtn");

const themeBtn = document.getElementById("themeBtn");

const historyBtn = document.getElementById("historyBtn");
const historyModal = document.getElementById("historyModal");
const closeHistory = document.getElementById("closeHistory");
const historyList = document.getElementById("historyList");

const correctionsList = document.getElementById("correctionsList");

const preview = document.getElementById("preview");
const previewBadge = document.getElementById("previewBadge");

const charCount = document.getElementById("charCount");
const wordCount = document.getElementById("wordCount");
const sentenceCount = document.getElementById("sentenceCount");

const statWords = document.getElementById("statWords");
const statChars = document.getElementById("statChars");
const statSentences = document.getElementById("statSentences");
const statErrors = document.getElementById("statErrors");

const errorBadge = document.getElementById("errorBadge");

const toast = document.getElementById("toast");


/* =========================================================
    UTILITÁRIOS
========================================================= */

function showToast(message) {

    toast.textContent = message;
    toast.classList.add("show");

    clearTimeout(showToast.timer);

    showToast.timer = setTimeout(() => {
        toast.classList.remove("show");
    }, 2500);
}


function setStatus(message, type = "") {

    status.className = "status";

    if (type) {
        status.classList.add(type);
    }

    status.innerHTML = message;
}


function countWords(value) {

    if (!value.trim()) {
        return 0;
    }

    return value.trim().split(/\s+/).length;
}


function countSentences(value) {

    if (!value.trim()) {
        return 0;
    }

    const matches = value.match(/[.!?]+(?=\s|$)/g);

    return matches ? matches.length : 1;
}


/* =========================================================
    ATUALIZAÇÃO DO EDITOR
========================================================= */

function updateText(newText, saveUndo = false) {

    if (newText.length > MAX_TEXT_LENGTH) {
        showToast("O texto ultrapassa o limite de 60.000 caracteres.");
        return;
    }

    if (saveUndo && text !== newText) {

        undoStack.push(text);

        if (undoStack.length > MAX_UNDO) {
            undoStack.shift();
        }

        redoStack = [];
    }

    text = newText;

    editor.value = text;

    corrections = [];

    updateStatistics();
    renderCorrections();
    renderPreview();

    setStatus("Texto modificado");
    updateUndoButtons();
}

function updateUndoButtons() {
    if (undoBtn) undoBtn.disabled = undoStack.length === 0;
    if (redoBtn) redoBtn.disabled = redoStack.length === 0;
}


/* =========================================================
    ESTATÍSTICAS
========================================================= */

function updateStatistics() {

    const chars = text.length;
    const words = countWords(text);
    const sentences = countSentences(text);

    charCount.textContent =
        `${chars.toLocaleString("pt-BR")} caracteres`;

    wordCount.textContent =
        `${words.toLocaleString("pt-BR")} palavras`;

    sentenceCount.textContent =
        `${sentences.toLocaleString("pt-BR")} frases`;

    statChars.textContent =
        chars.toLocaleString("pt-BR");

    statWords.textContent =
        words.toLocaleString("pt-BR");

    statSentences.textContent =
        sentences.toLocaleString("pt-BR");

    statErrors.textContent =
        corrections.length;

    errorBadge.textContent =
        corrections.length;

    previewBadge.textContent =
        `${corrections.length} ${
            corrections.length === 1 ? "erro" : "erros"
        }`;
}


/* =========================================================
    LANGUAGE TOOL
========================================================= */

async function requestAnalysis(content) {

    if (!content.trim()) {
        return [];
    }

    if (analysisController) {
        analysisController.abort();
    }

    analysisController = new AbortController();

    const params = new URLSearchParams();

    params.append("text", content);
    params.append("language", language.value);
    params.append("enabledOnly", "false");

    const response = await fetch(API_URL, {

        method: "POST",

        headers: {
            "Content-Type":
                "application/x-www-form-urlencoded"
        },

        body: params.toString(),

        signal: analysisController.signal

    });

    if (!response.ok) {

        throw new Error(
            `Erro HTTP ${response.status}`
        );
    }

    const data = await response.json();

    return Array.isArray(data.matches)
        ? data.matches
        : [];
}


/* =========================================================
    ANALISAR TEXTO
========================================================= */

async function analyzeText(saveHistory = true) {

    if (!text.trim()) {

        showToast("Digite algum texto primeiro.");

        editor.focus();

        return;
    }

    if (text.length > MAX_TEXT_LENGTH) {

        showToast(
            "O texto ultrapassa o limite permitido."
        );

        return;
    }

    isLoading = true;

    analyzeBtn.disabled = true;

    analyzeBtn.innerHTML =
        '<span class="loader"></span>Analisando...';

    setStatus(
        '<span class="loader"></span>Analisando texto...',
        "loading"
    );

    try {

        const result =
            await requestAnalysis(text);

        corrections = result;

        updateStatistics();

        renderCorrections();

        renderPreview();

        if (saveHistory) {
            saveHistoryItem();
        }

        if (corrections.length === 0) {

            setStatus(
                "✓ Nenhum erro encontrado",
                "success"
            );

            showToast(
                "Texto analisado sem correções."
            );

        } else {

            setStatus(
                `⚠ ${corrections.length} correção(ões) encontrada(s)`,
                "error"
            );

            showToast(
                `${corrections.length} correção(ões) encontrada(s).`
            );
        }

    } catch (error) {

        if (error.name === "AbortError") {
            return;
        }

        console.error(error);

        setStatus(
            "Erro ao conectar ao LanguageTool",
            "error"
        );

        showToast(
            "Não foi possível analisar o texto."
        );

    } finally {

        isLoading = false;

        analyzeBtn.disabled = false;

        analyzeBtn.innerHTML =
            "🔎 Analisar texto";
    }
}


/* =========================================================
    CONTEXTO DA CORREÇÃO
========================================================= */

function getCorrectionContext(correction) {

    const start = Math.max(
        0,
        correction.offset - 35
    );

    const end = Math.min(
        text.length,
        correction.offset +
        correction.length +
        35
    );

    let context =
        text.substring(start, end);

    context =
        context.replace(/\n/g, " ");

    return context;
}


/* =========================================================
    RENDERIZA CORREÇÕES
========================================================= */

function renderCorrections() {

    correctionsList.innerHTML = "";

    updateStatistics();

    if (!corrections.length) {

        correctionsList.innerHTML = `
            <div class="empty">
                ✓ Nenhuma correção encontrada.
            </div>
        `;

        return;
    }

    corrections.forEach((correction, index) => {

        const box =
            document.createElement("div");

        box.className = "correction";

        const message =
            document.createElement("div");

        message.className =
            "correction-message";

        message.textContent =
            correction.message ||
            "Possível problema encontrado.";

        const context =
            document.createElement("div");

        context.className =
            "correction-context";

        context.textContent =
            `"${getCorrectionContext(correction)}"`;

        const suggestions =
            document.createElement("div");

        suggestions.className =
            "suggestion-list";

        const replacementList =
            correction.replacements || [];

        if (!replacementList.length) {

            const noSuggestion =
                document.createElement("span");

            noSuggestion.className = "badge";

            noSuggestion.textContent =
                "Sem sugestão automática";

            suggestions.appendChild(
                noSuggestion
            );

        } else {

            replacementList
                .slice(0, 6)
                .forEach(replacement => {

                    const button =
                        document.createElement("button");

                    button.className =
                        "suggestion";

                    button.textContent =
                        replacement.value;

                    button.title =
                        "Aplicar esta sugestão";

                    button.addEventListener(
                        "click",
                        () => {

                            applySuggestion(
                                index,
                                replacement.value
                            );
                        }
                    );

                    suggestions.appendChild(button);
                });
        }

        box.appendChild(message);
        box.appendChild(context);
        box.appendChild(suggestions);

        correctionsList.appendChild(box);
    });
}


/* =========================================================
    APLICA SUGESTÃO
========================================================= */

async function applySuggestion(
    index,
    replacement
) {

    const correction =
        corrections[index];

    if (!correction) {
        return;
    }

    const start =
        correction.offset;

    const end =
        correction.offset +
        correction.length;

    const newText =
        text.substring(0, start) +
        replacement +
        text.substring(end);

    updateText(newText, true);

    setStatus(
        "Sugestão aplicada. Reanalisando...",
        "loading"
    );

    await analyzeText(false);
}


/* =========================================================
    CORRIGIR TUDO
========================================================= */

async function applyAllCorrections() {

    if (!corrections.length) {

        showToast(
            "Não existem correções para aplicar."
        );

        return;
    }

    const validCorrections =
        corrections
            .filter(item =>
                Array.isArray(item.replacements) &&
                item.replacements.length > 0
            )
            .sort(
                (a, b) =>
                    b.offset - a.offset
            );

    if (!validCorrections.length) {

        showToast(
            "Nenhuma correção automática disponível."
        );

        return;
    }

    let newText = text;
    let lastStart = Infinity;

    for (const correction of validCorrections) {

        const start =
            correction.offset;

        const end =
            correction.offset +
            correction.length;

        if (end > lastStart) {
            continue;
        }

        const replacement =
            correction.replacements[0].value;

        newText =
            newText.substring(0, start) +
            replacement +
            newText.substring(end);

        lastStart = start;
    }

    updateText(newText, true);

    setStatus(
        "Correções aplicadas. Reanalisando...",
        "loading"
    );

    await analyzeText(false);
}


/* =========================================================
    PREVIEW
========================================================= */

function escapeHTML(value) {

    return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


function renderPreview() {

    if (!text) {

        preview.innerHTML =
            'Digite um texto e clique em "Analisar texto".';

        return;
    }

    if (!corrections.length) {

        preview.textContent = text;

        return;
    }

    const sorted =
        [...corrections]
            .filter(item =>
                Number.isInteger(item.offset) &&
                Number.isInteger(item.length)
            )
            .sort(
                (a, b) =>
                    a.offset - b.offset
            );

    let html = "";
    let position = 0;

    for (const correction of sorted) {

        const start =
            correction.offset;

        const end =
            start +
            correction.length;

        if (start < position) {
            continue;
        }

        html += escapeHTML(
            text.substring(
                position,
                start
            )
        );

        html += `
            <span
                class="highlight"
                title="${escapeHTML(
                    correction.message || ""
                )}"
            >
                ${escapeHTML(
                    text.substring(start, end)
                )}
            </span>
        `;

        position = end;
    }

    html += escapeHTML(
        text.substring(position)
    );

    preview.innerHTML = html;
}


/* =========================================================
    DESFAZER / REFAZER
========================================================= */

function undo() {

    if (!undoStack.length) {
        showToast("Nada para desfazer.");
        return;
    }

    const previous = undoStack.pop();
    redoStack.push(text);

    text = previous;
    editor.value = text;
    corrections = [];

    updateStatistics();
    renderCorrections();
    renderPreview();
    setStatus("Alteração desfeita");
    updateUndoButtons();
}

function redo() {

    if (!redoStack.length) {
        showToast("Nada para refazer.");
        return;
    }

    const next = redoStack.pop();
    undoStack.push(text);

    text = next;
    editor.value = text;
    corrections = [];

    updateStatistics();
    renderCorrections();
    renderPreview();
    setStatus("Alteração refeita");
    updateUndoButtons();
}


/* =========================================================
    HISTÓRICO
========================================================= */

function loadHistory() {
    try {
        const saved = localStorage.getItem(STORAGE_HISTORY);
        history = saved ? JSON.parse(saved) : [];
    } catch (e) {
        history = [];
    }
}

function saveHistoryItem() {
    if (!text.trim()) return;

    if (history.length > 0 && history[0].text === text) return;

    history.unshift({
        text: text,
        date: new Date().toLocaleString("pt-BR")
    });

    if (history.length > MAX_HISTORY) {
        history.pop();
    }

    try {
        localStorage.setItem(STORAGE_HISTORY, JSON.stringify(history));
    } catch (e) {}
}

function renderHistoryModal() {
    loadHistory();
    historyList.innerHTML = "";

    if (!history.length) {
        historyList.innerHTML = '<div class="empty">Nenhum histórico salvo.</div>';
        return;
    }

    history.forEach((item, index) => {
        const div = document.createElement("div");
        div.className = "history-item";

        div.innerHTML = `
            <div style="font-size: 12px; color: var(--muted);">${item.date}</div>
            <div class="history-preview">${escapeHTML(item.text)}</div>
            <div class="history-actions">
                <button class="btn btn-primary" onclick="restoreHistory(${index})">Restaurar</button>
                <button class="btn btn-danger" onclick="deleteHistory(${index})">Excluir</button>
            </div>
        `;
        historyList.appendChild(div);
    });
}

window.restoreHistory = function(index) {
    if (history[index]) {
        updateText(history[index].text, true);
        historyModal.classList.remove("show");
        showToast("Texto restaurado do histórico.");
    }
};

window.deleteHistory = function(index) {
    history.splice(index, 1);
    try {
        localStorage.setItem(STORAGE_HISTORY, JSON.stringify(history));
    } catch (e) {}
    renderHistoryModal();
    showToast("Item removido do histórico.");
};


/* =========================================================
    EVENT LISTENERS & INICIALIZAÇÃO
========================================================= */

editor.addEventListener("input", (e) => {
    updateText(e.target.value, true);
    localStorage.setItem(STORAGE_TEXT, text);
});

analyzeBtn.addEventListener("click", () => analyzeText(true));
applyAllBtn.addEventListener("click", applyAllCorrections);

undoBtn.addEventListener("click", undo);
redoBtn.addEventListener("click", redo);

copyBtn.addEventListener("click", () => {
    if (!text) {
        showToast("Nada para copiar.");
        return;
    }
    navigator.clipboard.writeText(text);
    showToast("Texto copiado para a área de transferência!");
});

downloadBtn.addEventListener("click", () => {
    if (!text) {
        showToast("Nada para baixar.");
        return;
    }
    const blob = new Blob([text], { type: "text/plain;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "texto-corrigido.txt";
    a.click();
    URL.revokeObjectURL(url);
    showToast("Download iniciado!");
});

speakBtn.addEventListener("click", () => {
    if (!text) {
        showToast("Digite algo para ouvir.");
        return;
    }
    if (!('speechSynthesis' in window)) {
        showToast("Seu navegador não suporta leitura de voz.");
        return;
    }
    if (isSpeaking) {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        speakBtn.textContent = "🔊 Ouvir";
        return;
    }
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = language.value;
    utterance.onend = () => {
        isSpeaking = false;
        speakBtn.textContent = "🔊 Ouvir";
    };
    isSpeaking = true;
    speakBtn.textContent = "⏹ Parar";
    window.speechSynthesis.speak(utterance);
});

importBtn.addEventListener("click", () => fileInput.click());

fileInput.addEventListener("change", (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
        updateText(event.target.result, true);
        showToast("Arquivo importado com sucesso!");
    };
    reader.readAsText(file);
    fileInput.value = "";
});

clearBtn.addEventListener("click", () => {
    if (!text) return;
    if (confirm("Deseja realmente limpar todo o texto?")) {
        updateText("", true);
        showToast("Editor limpo.");
    }
});

themeBtn.addEventListener("click", () => {
    document.body.classList.toggle("dark");
    const isDark = document.body.classList.contains("dark");
    localStorage.setItem(STORAGE_THEME, isDark ? "dark" : "light");
    themeBtn.textContent = isDark ? "☀️ Tema" : "🌙 Tema";
});

fontSize.addEventListener("change", (e) => {
    editor.style.fontSize = e.target.value + "px";
    localStorage.setItem(STORAGE_FONT, e.target.value);
});

language.addEventListener("change", (e) => {
    localStorage.setItem(STORAGE_LANGUAGE, e.target.value);
});

historyBtn.addEventListener("click", () => {
    renderHistoryModal();
    historyModal.classList.add("show");
});

closeHistory.addEventListener("click", () => {
    historyModal.classList.remove("show");
});

document.getElementById("launchAppBtn").addEventListener("click", function(e) {
    e.preventDefault();
    editor.scrollIntoView({ behavior: "smooth" });
    editor.focus();
});

// Ações dos botões da Capa Interativa
document.getElementById("coverEditBtn").addEventListener("click", () => {
    editor.scrollIntoView({ behavior: "smooth" });
    editor.focus();
});

document.getElementById("coverAnalyzeBtn").addEventListener("click", () => {
    editor.scrollIntoView({ behavior: "smooth" });
    analyzeText(true);
});

document.getElementById("coverApplyBtn").addEventListener("click", () => {
    editor.scrollIntoView({ behavior: "smooth" });
    applyAllCorrections();
});

document.getElementById("coverDownloadBtn").addEventListener("click", () => {
    if (!text) {
        showToast("Nada para baixar. Adicione texto primeiro.");
        return;
    }
    downloadBtn.click();
});

// Atalhos de teclado
document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        undo();
    } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y') {
        e.preventDefault();
        redo();
    }
});

// Inicialização de Preferências Salvas
window.addEventListener("DOMContentLoaded", () => {
    try {
        const savedTheme = localStorage.getItem(STORAGE_THEME);
        if (savedTheme === "dark") {
            document.body.classList.add("dark");
            themeBtn.textContent = "☀️ Tema";
        }

        const savedLang = localStorage.getItem(STORAGE_LANGUAGE);
        if (savedLang) language.value = savedLang;

        const savedFont = localStorage.getItem(STORAGE_FONT);
        if (savedFont) {
            fontSize.value = savedFont;
            editor.style.fontSize = savedFont + "px";
        }

        const savedText = localStorage.getItem(STORAGE_TEXT);
        if (savedText) {
            updateText(savedText, false);
        }
    } catch (e) {}
    updateUndoButtons();
});
</script>

