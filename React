<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Corretor Inteligente PRO ULTRA - Capa do App</title>
<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<!-- Canvas Confetti for celebration effects -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
    body {
        font-family: 'Inter', sans-serif;
    }
    .glow-effect {
        box-shadow: 0 0 50px -10px rgba(99, 102, 241, 0.4);
    }
    .text-gradient {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #ec4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .gold-gradient {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .app-screen-bg {
        background: radial-gradient(circle at top, #1e1b4b 0%, #090d16 70%);
    }
    /* Custom Scrollbar for modal content */
    ::-webkit-scrollbar {
        width: 6px;
    }
    ::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
    }
    ::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }
</style>
</head>
<body class="bg-[#030712] text-slate-100 min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white overflow-x-hidden">

    <!-- Background Ambient Glows -->
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-indigo-600/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-purple-600/15 rounded-full blur-[120px] pointer-events-none"></div>

    <!-- Header / Navbar -->
    <header class="w-full max-w-7xl mx-auto px-6 py-6 flex items-center justify-between z-10">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/30 text-white font-bold text-lg">
                ✍️
            </div>
            <span class="font-bold text-xl tracking-tight text-white">Corretor <span class="text-gradient">PRO ULTRA</span></span>
        </div>
        <div class="flex items-center gap-4">
            <a href="#features" class="hidden sm:inline-block text-sm text-slate-400 hover:text-white transition">Recursos</a>
            <button onclick="triggerDownload()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold px-4 py-2 rounded-xl transition shadow-lg shadow-indigo-600/20 active:scale-95">
                Baixar App
            </button>
        </div>
    </header>

    <!-- Hero Section with Smartphone Mockup -->
    <main class="w-full max-w-7xl mx-auto px-6 py-8 flex flex-col lg:flex-row items-center justify-center gap-12 lg:gap-20 z-10 my-auto">
        
        <!-- Left Text Info -->
        <div class="flex-1 text-center lg:text-left max-w-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold mb-6">
                <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span> Inteligência Artificial Avançada
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-6">
                Escreva perfeitamente, <span class="text-gradient">sem esforço algum.</span>
            </h1>
            <p class="text-slate-400 text-base sm:text-lg mb-8 leading-relaxed">
                O corretor gramatical definitivo para textos impecáveis em múltiplos idiomas. Correção em tempo real, sugestões contextuais e análises profundas na palma da sua mão.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                <button onclick="triggerDownload()" class="w-full sm:w-auto bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:opacity-95 text-white font-bold px-8 py-4 rounded-2xl shadow-xl shadow-indigo-500/25 transition transform hover:-translate-y-0.5 active:translate-y-0 text-base">
                    🚀 Baixar Agora (Grátis)
                </button>
                <a href="#features" class="w-full sm:w-auto bg-slate-900/80 hover:bg-slate-800 border border-slate-800 text-slate-300 font-medium px-6 py-4 rounded-2xl transition text-center text-base">
                    Ver Funcionalidades
                </a>
            </div>
            <div class="mt-8 flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-500">
                <div class="flex items-center gap-1.5">✓ Sem anúncios invasivos</div>
                <div class="flex items-center gap-1.5">✓ 100% Funcional no navegador</div>
                <div class="flex items-center gap-1.5">✓ Multi-idiomas</div>
            </div>
        </div>

        <!-- Right: Interactive Smartphone Frame Mockup -->
        <div class="relative flex-shrink-0 flex items-center justify-center">
            
            <!-- Glow behind phone -->
            <div class="absolute w-[300px] h-[550px] bg-gradient-to-b from-indigo-500/30 via-purple-500/20 to-pink-500/10 rounded-[50px] blur-3xl pointer-events-none"></div>

            <!-- iPhone Frame -->
            <div class="relative w-[320px] sm:w-[350px] h-[670px] bg-slate-950 rounded-[50px] p-3.5 border-4 border-slate-800/80 shadow-2xl glow-effect flex flex-col justify-between overflow-hidden">
                
                <!-- Notch / Dynamic Island -->
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-32 h-6 bg-black rounded-full z-30 flex items-center justify-center">
                    <div class="w-3 h-3 bg-slate-900 rounded-full mr-3 border border-slate-800"></div>
                    <div class="w-2.5 h-2.5 bg-indigo-950 rounded-full"></div>
                </div>

                <!-- Phone Screen Content -->
                <div class="relative w-full h-full app-screen-bg rounded-[40px] pt-10 pb-4 px-5 flex flex-col justify-between overflow-hidden border border-white/10">

                    <!-- App Top Area -->
                    <div class="text-center pt-2">
                        <div class="w-14 h-14 mx-auto rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center text-2xl shadow-lg shadow-indigo-500/40 mb-3 border border-white/20 animate-bounce">
                            ✍️
                        </div>
                        <h2 class="text-lg font-extrabold tracking-tight text-white">Corretor Inteligente</h2>
                        <p class="text-xs font-semibold gold-gradient">PRO ULTRA ✨</p>
                    </div>

                    <!-- App Mini Preview Card Inside Phone -->
                    <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-4 my-2 shadow-inner backdrop-blur-md">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[11px] font-semibold text-slate-400">Editor Ativo</span>
                            <span class="bg-emerald-500/20 text-emerald-400 text-[10px] px-2 py-0.5 rounded-full font-bold">Online</span>
                        </div>
                        <div class="bg-slate-950/80 rounded-xl p-3 border border-slate-800/50 text-xs text-slate-300 font-mono leading-relaxed relative">
                            <span>O texto foi analisado e <span class="bg-rose-500/25 border-b border-rose-500 text-rose-300 px-1 rounded">encontrou-se</span> 2 erros gramaticais.</span>
                        </div>
                        <div class="mt-3 flex items-center justify-between text-[10px] text-slate-400 font-medium">
                            <span>148 palavras</span>
                            <span class="text-indigo-400 font-bold">Idioma: PT-BR</span>
                        </div>
                    </div>

                    <!-- Interactive Bottom Bar (As requested in image description & prompt) -->
                    <div>
                        <div class="text-[10px] text-center text-slate-400 mb-2 uppercase tracking-wider font-bold">Toque para testar os recursos:</div>
                        <div class="grid grid-cols-4 gap-2 bg-slate-950/90 p-2.5 rounded-2xl border border-slate-800">
                            
                            <!-- Button 1: Revisão -->
                            <button onclick="openModal('revisao')" class="group flex flex-col items-center justify-center p-2 rounded-xl bg-slate-900 hover:bg-indigo-600/20 hover:border-indigo-500 border border-transparent transition active:scale-95">
                                <span class="text-lg mb-1 group-hover:scale-110 transition">📝</span>
                                <span class="text-[10px] font-medium text-slate-300 group-hover:text-indigo-300">Revisão</span>
                            </button>

                            <!-- Button 2: IA Inteligente -->
                            <button onclick="openModal('ia')" class="group flex flex-col items-center justify-center p-2 rounded-xl bg-slate-900 hover:bg-purple-600/20 hover:border-purple-500 border border-transparent transition active:scale-95">
                                <span class="text-lg mb-1 group-hover:scale-110 transition">🧠</span>
                                <span class="text-[10px] font-medium text-slate-300 group-hover:text-purple-300">IA Intel.</span>
                            </button>

                            <!-- Button 3: Correção Total -->
                            <button onclick="openModal('correcao')" class="group flex flex-col items-center justify-center p-2 rounded-xl bg-slate-900 hover:bg-emerald-600/20 hover:border-emerald-500 border border-transparent transition active:scale-95">
                                <span class="text-lg mb-1 group-hover:scale-110 transition">✨</span>
                                <span class="text-[10px] font-medium text-slate-300 group-hover:text-emerald-300">Corr. Total</span>
                            </button>

                            <!-- Button 4: Estatísticas -->
                            <button onclick="openModal('estatisticas')" class="group flex flex-col items-center justify-center p-2 rounded-xl bg-slate-900 hover:bg-amber-600/20 hover:border-amber-500 border border-transparent transition active:scale-95">
                                <span class="text-lg mb-1 group-hover:scale-110 transition">📊</span>
                                <span class="text-[10px] font-medium text-slate-300 group-hover:text-amber-300">Estatist.</span>
                            </button>

                        </div>
                    </div>

                    <!-- Main Download Button Inside Phone -->
                    <button onclick="triggerDownload()" class="mt-3 w-full bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white font-bold py-3 px-4 rounded-xl text-xs transition shadow-lg shadow-indigo-500/30 flex items-center justify-center gap-2 active:scale-95">
                        <span>Baixar Agora</span>
                        <span>✨</span>
                    </button>

                </div>

            </div>

        </div>

    </main>

    <!-- Features Section -->
    <section id="features" class="w-full max-w-7xl mx-auto px-6 py-16 border-t border-slate-900 z-10">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3">Recursos de Alto Desempenho</h2>
            <p class="text-slate-400 text-sm sm:text-base">Tudo o que você precisa para escrever com clareza, gramática impecável e estilo profissional.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <div class="bg-slate-900/60 border border-slate-800/80 p-6 rounded-2xl hover:border-indigo-500/50 transition">
                <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-2xl mb-4">📝</div>
                <h3 class="font-bold text-lg mb-2 text-white">Revisão Instantânea</h3>
                <p class="text-slate-400 text-sm">Detecção imediata de desvios gramaticais, ortográficos e pontuação incorreta enquanto você digita.</p>
            </div>

            <div class="bg-slate-900/60 border border-slate-800/80 p-6 rounded-2xl hover:border-purple-500/50 transition">
                <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-2xl mb-4">🧠</div>
                <h3 class="font-bold text-lg mb-2 text-white">IA Inteligente</h3>
                <p class="text-slate-400 text-sm">Sugestões contextuais avançadas baseadas em LanguageTool para reescrever frases com elegância.</p>
            </div>

            <div class="bg-slate-900/60 border border-slate-800/80 p-6 rounded-2xl hover:border-emerald-500/50 transition">
                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-2xl mb-4">✨</div>
                <h3 class="font-bold text-lg mb-2 text-white">Correção Total</h3>
                <p class="text-slate-400 text-sm">Aplique dezenas de correções automáticas em um único clique para máxima produtividade.</p>
            </div>

            <div class="bg-slate-900/60 border border-slate-800/80 p-6 rounded-2xl hover:border-amber-500/50 transition">
                <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-2xl mb-4">📊</div>
                <h3 class="font-bold text-lg mb-2 text-white">Estatísticas Completas</h3>
                <p class="text-slate-400 text-sm">Acompanhe contagem de palavras, caracteres, frases e tempo estimado de leitura em tempo real.</p>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="w-full max-w-7xl mx-auto px-6 py-8 border-t border-slate-900 text-center text-xs text-slate-500 z-10">
        <p>© 2026 Corretor Inteligente PRO ULTRA. Todos os direitos reservados.</p>
    </footer>

    <!-- INTERACTIVE MODAL POPUP -->
    <div id="infoModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4 z-50 transition-opacity">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-md w-full p-6 shadow-2xl relative transform scale-95 transition-transform" id="modalContainer">
            <button onclick="closeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white bg-slate-800/60 w-8 h-8 rounded-full flex items-center justify-center transition">✕</button>
            <div id="modalIcon" class="text-3xl mb-3">✨</div>
            <h3 id="modalTitle" class="text-xl font-bold text-white mb-2">Título do Recurso</h3>
            <p id="modalDescription" class="text-slate-300 text-sm leading-relaxed mb-6">Descrição detalhada do recurso selecionado.</p>
            <button onclick="closeModal()" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 rounded-xl transition text-sm">Entendi</button>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toastNotification" class="fixed bottom-6 right-6 bg-slate-900 border border-slate-800 text-white px-5 py-3 rounded-2xl shadow-2xl transform translate-y-24 opacity-0 transition-all duration-300 z-50 flex items-center gap-3">
        <span id="toastIcon">🎉</span>
        <span id="toastText" class="text-sm font-medium">Aplicativo pronto para uso!</span>
    </div>

    <!-- SCRIPT FOR INTERACTIVITY -->
    <script>
        const modalData = {
            revisao: {
                icon: "📝",
                title: "Módulo de Revisão",
                desc: "O sistema analisa o texto caractere por caractere, destacando desvios gramaticais, concordância incorreta e problemas de ortografia com explicações detalhadas."
            },
            ia: {
                icon: "🧠",
                title: "IA Inteligente Avançada",
                desc: "Powered by LanguageTool e motores de linguagem modernos, oferecendo sugestões contextuais inteligentes adequadas para português do Brasil, Portugal, inglês, espanhol e mais."
            },
            correcao: {
                icon: "✨",
                title: "Correção Total em 1 Clique",
                desc: "Identifique e resolva todos os problemas do seu texto instantaneamente com o botão de correção em lote, economizando minutos preciosos de edição."
            },
            estatisticas: {
                icon: "📊",
                title: "Estatísticas Detalhadas",
                desc: "Tenha controle absoluto sobre o tamanho do seu conteúdo com métricas precisas de palavras, caracteres, frases e histórico completo salvo automaticamente."
            }
        };

        function openModal(type) {
            const data = modalData[type];
            if (!data) return;

            document.getElementById('modalIcon').textContent = data.icon;
            document.getElementById('modalTitle').textContent = data.title;
            document.getElementById('modalDescription').textContent = data.desc;

            const modal = document.getElementById('infoModal');
            const container = document.getElementById('modalContainer');
            
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                container.classList.remove('scale-95');
                container.classList.add('scale-100');
            }, 10);
        }

        function closeModal() {
            const modal = document.getElementById('infoModal');
            const container = document.getElementById('modalContainer');
            
            container.classList.remove('scale-100');
            container.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }, 150);
        }

        function triggerDownload() {
            // Trigger Confetti Celebration
            confetti({
                particleCount: 120,
                spread: 80,
                origin: { y: 0.6 }
            });

            showToast("🎉 App pronto! Redirecionando para a área de edição...");
            
            setTimeout(() => {
                // If embedded in collaborative editor, switch or show notification
                showToast("✨ Bem-vindo ao Corretor Inteligente PRO ULTRA!");
            }, 1500);
        }

        function showToast(message) {
            const toast = document.getElementById('toastNotification');
            const toastText = document.getElementById('toastText');
            toastText.textContent = message;

            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3000);
        }

        // Close modal on background click
        document.getElementById('infoModal').addEventListener('click', (e) => {
            if (e.target.id === 'infoModal') {
                closeModal();
            }
        });
    </script>

</body>
</html>
