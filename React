import React, { useState } from "react";

function TextAnalyzer() {
  const [text, setText] = useState("");
  const [corrections, setCorrections] = useState([]);

  const analyzeText = async () => {
    const response = await fetch("https://api.languagetool.org/v2/check", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({
        text: text,
        language: "pt-BR"
      })
    });
    const data = await response.json();
    setCorrections(data.matches);
  };

  // Função para destacar erros no texto
  const highlightText = () => {
    let highlighted = text;
    corrections.forEach((c) => {
      if (c.replacements.length > 0) {
        const wrong = text.substring(c.offset, c.offset + c.length);
        const suggestion = c.replacements[0].value;
        highlighted = highlighted.replace(
          wrong,
          `<span style="background-color: #ffcccc;" title="${c.message} → ${suggestion}">${wrong}</span>`
        );
      }
    });
    return highlighted;
  };

  return (
    <div style={{ fontFamily: "Arial, sans-serif", padding: "20px" }}>
      <h2>Corretor de Texto Inteligente</h2>
      <textarea
        value={text}
        onChange={(e) => setText(e.target.value)}
        placeholder="Digite seu texto..."
        rows={6}
        cols={60}
        style={{ padding: "10px", fontSize: "16px" }}
      />
      <br />
      <button onClick={analyzeText} style={{ marginTop: "10px" }}>
        Analisar
      </button>

      <h3>Texto analisado:</h3>
      <div
        style={{
          border: "1px solid #ccc",
          padding: "10px",
          marginTop: "10px",
          minHeight: "100px"
        }}
        dangerouslySetInnerHTML={{ __html: highlightText() }}
      />

      <h3>Correções sugeridas:</h3>
      <ul>
        {corrections.map((c, i) => (
          <li key={i}>
            <strong>{c.message}</strong>  
            <br />
            Palavra incorreta: <em>{text.substring(c.offset, c.offset + c.length)}</em>  
            <br />
            Sugestões: {c.replacements.map(r => r.value).join(", ")}
          </li>
        ))}
      </ul>
    </div>
  );
}

export default TextAnalyzer;
