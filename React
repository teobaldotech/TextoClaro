    </div>

    <!-- HEADER -->
    <header class="header">

        <div class="brand">
            <div class="logo">✍️</div>

            <div>
                <h1>Corretor Inteligente <span style="color:#8b5cf6">PRO ULTRA</span></h1>
                <p>Correção gramatical, ortográfica e análise inteligente</p>
            </div>
        </div>

        <div class="header-actions">
