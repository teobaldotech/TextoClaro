<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Corretor Inteligente PRO ULTRA</title>

<style>
/* Correção do seletor universal de reset */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #eef2ff;
    --card: #ffffff;
    --card2: #f8fafc;
    --text: #172033;
    --muted: #64748b;
    --primary: #6366f1;
    --primary2: #8b5cf6;
    --success: #16a34a;
    --danger: #ef4444;
    --warning: #f59e0b;
    --border: #dbe2ea;
    --shadow: 0 15px 45px rgba(15, 23, 42, .10);
}

body.dark {
    --bg: #070b17;
    --card: #111827;
    --card2: #0f172a;
    --text: #f8fafc;
    --muted: #94a3b8;
    --border: #243047;
    --shadow: 0 15px 45px rgba(0, 0, 0, .35);
}

body {
    font-family: Inter, Arial, sans-serif;
    background:
        radial-gradient(circle at top left, rgba(99,102,241,.15), transparent 30%),
        radial-gradient(circle at bottom right, rgba(139,92,246,.12), transparent 30%),
        var(--bg);
    color: var(--text);
    min-height: 100vh;
    transition: .3s;
}

button,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

.app {
    max-width: 1500px;
    margin: auto;
    padding: 20px;
}

/* HEADER */

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

.brand {
    display: flex;
    align-items: center;
    gap: 14px;
}

.logo {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    font-size: 28px;
    color: white;
    background: linear-gradient(135deg, var(--primary), var(--primary2));
    box-shadow: 0 10px 30px rgba(99,102,241,.35);
}

.brand h1 {
    font-size: clamp(22px, 4vw, 34px);
}

.brand p {
    color: var(--muted);
    margin-top: 4px;
}

.header-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
}

.btn {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 12px;
    padding: 10px 14px;
    transition: .2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    color: white;
    border: none;
    background: linear-gradient(135deg, var(--primary), var(--primary2));
}

.btn-launch {
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
    animation: pulseGlow 2s infinite;
}

@keyframes pulseGlow {
    0% {
        box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.5);
    }
    70% {
        box-shadow: 0 0 0 10px rgba(99, 102, 241, 0);
    }
    100% {
        box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);
    }
}

.btn-success {
    color: white;
    border: none;
    background: var(--success);
}

.btn-danger {
    color: white;
    border: none;
    background: var(--danger);
}

/* APP COVER HERO BANNER */
.app-cover {
    background: linear-gradient(135deg, rgba(17, 24, 39, 0.95), rgba(15, 23, 42, 0.98));
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 30px 20px;
    text-align: center;
    margin-bottom: 25px;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
}

.app-cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(99,102,241,.15), transparent 70%);
    pointer-events: none;
}

.cover-logo {
    width: 72px;
    height: 72px;
    border-radius: 22px;
    display: inline-grid;
    place-items: center;
    font-size: 36px;
    color: white;
    background: linear-gradient(135deg, var(--primary), var(--primary2));
    box-shadow: 0 12px 35px rgba(99,102,241,.4);
    margin-bottom: 15px;
}

.cover-title {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 6px;
}

.cover-subtitle {
    color: var(--muted);
    font-size: clamp(14px, 2vw, 16px);
    margin-bottom: 20px;
}

.cover-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    max-width: 800px;
    margin: 0 auto;
}

.cover-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f8fafc;
    padding: 10px 16px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all .2s ease;
    cursor: pointer;
    text-decoration: none;
}

.cover-btn:hover {
    background: var(--primary);
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99,102,241,.35);
}

/* TOOLBAR */

.toolbar {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    box-shadow: var(--shadow);
    margin-bottom: 18px;
}

.toolbar-group {
    display: flex;
    align-items: center;
    gap: 7px;
}

.toolbar label {
    color: var(--muted);
    font-size: 13px;
}

select,
.input {
    border: 1px solid var(--border);
    background: var(--card2);
    color: var(--text);
    border-radius: 10px;
    padding: 9px 11px;
    outline: none;
}

select:focus,
.input:focus,
textarea:focus {
    border-color: var(--primary);
}

/* MAIN */

.main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 18px;
}

.editor-card,
.side-card,
.stats-card,
.preview-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow);
}

.editor-card {
    overflow: hidden;
}

.editor-header {
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.editor-title {
    font-weight: 800;
}

.status {
    font-size: 13px;
    color: var(--muted);
}

.status.loading {
    color: var(--primary);
}

.status.success {
    color: var(--success);
}

.status.error {
    color: var(--danger);
}

.editor-wrap {
    position: relative;
}

#editor {
    width: 100%;
    min-height: 430px;
    resize: vertical;
    padding: 22px;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font-size: 18px;
    line-height: 1.75;
}

.editor-footer {
    padding: 12px 18px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 13px;
}

.word-count {
    display: flex;
    gap: 15px;
}

/* SIDEBAR */

.sidebar {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.side-card {
    padding: 18px;
}

.side-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.side-title h3 {
    font-size: 17px;
}

.badge {
    background: rgba(99,102,241,.13);
    color: var(--primary);
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
}

.stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.stat {
    padding: 14px;
    border-radius: 14px;
    background: var(--card2);
    border: 1px solid var(--border);
}

.stat strong {
    display: block;
    font-size: 25px;
    margin-bottom: 4px;
}

.stat span {
    color: var(--muted);
    font-size: 12px;
}

/* CORRECTIONS */

.corrections-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 550px;
    overflow: auto;
}

.correction {
    border: 1px solid var(--border);
    border-left: 4px solid var(--danger);
    border-radius: 12px;
    padding: 12px;
    background: var(--card2);
}

.correction-message {
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 8px;
}

.correction-context {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 10px;
}

.suggestion-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.suggestion {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 8px;
    padding: 6px 9px;
    font-size: 12px;
}

.suggestion:hover {
    border-color: var(--primary);
    color: var(--primary);
}

/* PREVIEW */

.preview-card {
    margin-top: 18px;
    padding: 18px;
}

.preview {
    line-height: 1.8;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--text);
}

.highlight {
    background: rgba(239,68,68,.18);
    border-bottom: 2px solid var(--danger);
    border-radius: 3px;
    padding: 1px 2px;
}

/* HISTORY */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(2,6,23,.7);
    backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 1000;
}

.modal.show {
    display: flex;
}

.modal-box {
    width: min(850px, 100%);
    max-height: 85vh;
    overflow: auto;
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow);
}

.modal-header {
    padding: 18px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.history-item {
    padding: 15px 18px;
    border-bottom: 1px solid var(--border);
}

.history-item:last-child {
    border-bottom: none;
}

.history-preview {
    color: var(--muted);
    margin: 8px 0;
    white-space: pre-wrap;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
}

.history-actions {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
}

/* TOAST */

.toast {
    position: fixed;
    right: 20px;
    bottom: 20px;
    background: #111827;
    color: white;
    padding: 13px 17px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,.3);
    transform: translateY(100px);
    opacity: 0;
    transition: .3s;
    z-index: 2000;
}

.toast.show {
    transform: translateY(0);
    opacity: 1;
}

/* EMPTY */

.empty {
    padding: 25px 10px;
    text-align: center;
    color: var(--muted);
}

/* LOADER */

.loader {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(99,102,241,.25);
    border-top-color: var(--primary);
    border-radius: 50%;
    display: inline-block;
    animation: spin .7s linear infinite;
    vertical-align: middle;
    margin-right: 5px;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* RESPONSIVE */

@media (max-width: 1000px) {
    .main-grid {
        grid-template-columns: 1fr;
    }

    .sidebar {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 650px) {
    .app {
        padding: 10px;
    }

    .sidebar {
        display: flex;
    }

    #editor {
        min-height: 350px;
        font-size: 16px;
    }

    .header {
        align-items: flex-start;
    }

    .toolbar {
        align-items: stretch;
    }

    .toolbar-group {
        width: 100%;
    }

    .toolbar-group select {
        flex: 1;
    }

    .btn {
        padding: 9px 11px;
    }
}
</style>
</head>

<body>

<div class="app">

    <!-- CAPA / HERO BANNER INTERATIVO -->
    <div class="app-cover">
        <div class="cover-logo">✒️</div>
        <div class="cover-title">Corretor Inteligente <span style="color:#8b5cf6">PRO ULTRA</span></div>
        <div class="cover-subtitle">Correção gramatical, ortográfica e análise inteligente em tempo real</div>
        
        <div class="cover-actions">
            <button class="cover-btn" id="coverEditBtn">✏️ Usar Editor</button>
            <button class="cover-btn" id="coverAnalyzeBtn">🔍 Analisar Texto</button>
